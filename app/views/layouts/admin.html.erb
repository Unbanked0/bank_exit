<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <%= seo_meta_tags(@pagy) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= stylesheet_link_tag 'https://unpkg.com/leaflet@2.0.0-alpha.1/dist/leaflet.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/leaflet-gesture-handling@1.2.2/dist/leaflet-gesture-handling.min.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/@kristjan.esperanto/leaflet.markercluster@3/dist/MarkerCluster.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/@kristjan.esperanto/leaflet.markercluster@3/dist/MarkerCluster.Default.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/leaflet.fullscreen/dist/Control.FullScreen.css' %>

    <%= stylesheet_link_tag :app %>

    <%= render 'initial_javascript' %>
    <%= javascript_importmap_tags %>

    <%= debugbar_head if defined?(Debugbar) %>
  </head>

  <body
    class="admin"
    data-controller="theme"
    data-theme-light-value="<%= @themes[:light] %>"
    data-theme-dark-value="<%= @themes[:dark] %>"
  >
    <%= turbo_stream_from :flashes %>
    <%= turbo_stream_from [:flashes, I18n.locale] %>

    <div id="flashes"><%= render 'flashes' %></div>

    <main class="drawer lg:drawer-open">
      <input class="drawer-toggle" id="sidebarDrawer" type="checkbox">

      <div class="drawer-content">
        <header
          class="
            flex flex-col lg:flex-row items-center justify-between
            bg-base-200 border-b-2 border-primary p-2 lg:pl-4 gap-3
          "
        >
          <div class="flex items-center gap-2">
            <%= link_to admin_root_path, class: 'lg:hidden' do %>
              <%= image_tag logo_by_locale, class: 'w-12', alt: 'Bank-Exit logo' %>
            <% end %>

            <% if content_for?(:page_title) %>
              <h1 class="lg:text-3xl truncate"><%= yield :page_title %></h1>
            <% end %>
          </div>

          <div class="flex items-center gap-2">
            <% if content_for?(:page_actions) %>
              <%= yield(:page_actions) %>
            <% end %>

            <label
              class="btn btn-sm btn-square btn-neutral drawer-button lg:hidden"
              for="sidebarDrawer"
            >
              <%= lucide_icon 'menu', class: 'w-5 h-5' %>
            </label>
          </div>
        </header>

        <div class="p-4"><%= yield %></div>
      </div>

      <%= render 'admin/sidebar' %>
    </main>

    <div id="modal"></div>

    <%= render 'modal', id: 'turbo-confirm' %>
    <%= render 'ribbon' if FeatureFlag.enabled?(:ribbon) %>
    <%= render 'debugbar' if defined?(Debugbar) %>
  </body>
</html>
