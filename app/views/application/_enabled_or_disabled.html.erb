<% if enabled %>
  <div
    aria-label="Status"
    class="
      status status-lg status-success flex items-center justify-center w-5
      h-5 rounded-full
    "
  >
    <%= lucide_icon 'check', class: 'text-success-content' %>
  </div>
<% else %>
  <div
    aria-label="Status"
    class="
      status status-lg status-error flex items-center justify-center w-5 h-5
      rounded-full
    "
  >
    <%= lucide_icon 'x', class: 'text-error-content' %>
  </div>
<% end %>
