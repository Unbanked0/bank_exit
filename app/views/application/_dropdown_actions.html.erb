<%# locals: (item_id:, details_html: {}, button_style: {}, aria: nil) %>

<% button_attributes = button_style.deep_dup
button_attributes[:aria] = aria if aria.present?
dropdown_attributes = details_html.deep_dup %>

<button
  class="btn btn-square"
  popovertarget="popover-<%= item_id %>"
  style="anchor-name:--anchor-<%= item_id %>"
  <%= tag.attributes(button_attributes) %>
>
  <%= lucide_icon "ellipsis-vertical" %>
</button>

<div
  class="
    dropdown dropdown-end rounded-box bg-base-100 border
    border-base-content/20 shadow-sm
  "
  popover
  id="popover-<%= item_id %>"
  style="position-anchor:--anchor-<%= item_id %>"
  <%= tag.attributes(dropdown_attributes) %>
>
  <%= yield :dropdown_header %>

  <ul class="menu space-y-2">
    <%= yield :dropdown_menu %>
  </ul>
</div>
