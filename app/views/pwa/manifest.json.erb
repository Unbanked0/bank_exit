{
  "name": "<%= [I18n.t('seo.default.title', locale: params[:locale]), Rails.env.production? ? nil : Rails.env].compact.join(" - ") %>",
  "description": "<%= I18n.t('seo.default.description', locale: params[:locale]).html_safe %>",
  "start_url": "/<%= params[:locale] %>/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#f7931a",
  "background_color": "#FFF",
  "icons": [
    {
      "src": "/pwa/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-192x192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/pwa/app-screenshot.jpg",
      "type": "image/jpg",
      "sizes": "2064x1418",
      "form_factor": "wide"
    },
    {
      "src": "/pwa/app-screenshot.jpg",
      "type": "image/jpg",
      "sizes": "2064x1418"
    }
  ]
}
