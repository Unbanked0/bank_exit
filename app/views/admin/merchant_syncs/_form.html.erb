<%# locals: (merchant_sync:) %>

<%= simple_form_for [:admin, merchant_sync],
                    html: {
                      class: 'space-y-8'
                    } do |f| %>
  <% if merchant_sync.errors.any? %>
    <div class="alert alert-error">
      <ul class="list-disc list-inside">
        <% merchant_sync.errors.each do |error| %>
          <li>
            <%= error.full_message %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="alert alert-error">
    <p class="flex items-center gap-2">
      <%= lucide_icon 'triangle-alert' %> Only use this form if you know what
      you are doing!
    </p>
  </div>

  <div class="flex flex-col lg:flex-row items-center justify-between gap-3">
    <%= f.input :id, disabled: true %>
    <%= f.input :started_at, html5: true, disabled: true %>
    <%= f.input :ended_at, html5: true, disabled: true %>
  </div>

  <div class="flex flex-col lg:flex-row items-center justify-between gap-3">
    <%= f.input :added_merchants_count %>
    <%= f.input :updated_merchants_count %>
    <%= f.input :soft_deleted_merchants_count %>
  </div>

  <%= f.input :notes %>

  <div class="divider divider-primary">
    Merchants payloads
  </div>

  <%= f.input :payload_added_merchants,
              as: :text,
              input_html: {
                rows: 18,
                value: JSON.pretty_generate(merchant_sync.payload_added_merchants),
                class: 'font-mono max-h-96'
              } %>

  <%= f.input :payload_updated_merchants,
              as: :text,
              input_html: {
                rows: 18,
                value: JSON.pretty_generate(merchant_sync.payload_updated_merchants),
                class: 'font-mono max-h-96'
              } %>

  <%= f.input :payload_soft_deleted_merchants,
              as: :text,
              input_html: {
                rows: 18,
                value: JSON.pretty_generate(merchant_sync.payload_soft_deleted_merchants),
                class: 'font-mono max-h-96'
              } %>

  <%= f.input :payload_countries,
              as: :text,
              input_html: {
                rows: 18,
                value: JSON.pretty_generate(merchant_sync.payload_countries),
                class: 'font-mono max-h-96'
              } %>

  <% if f.object.nostr_event %>
    <div class="divider divider-secondary">
      Nostr <%= social_contact_icon(:nostr, klass: 'w-16 -ml-3') %>
    </div>
    <%= f.simple_fields_for :nostr_event do |ff| %>
      <div class="flex flex-col lg:flex-row gap-3">
        <div class="space-y-2">
          <%= ff.input :identifier, disabled: true %>
          <%= ff.input :event_identifier %>

          <%= ff.input :payload_response,
                       as: :text,
                       input_html: {
                         rows: 18,
                         value: JSON.pretty_generate(ff.object.payload_response),
                         class: 'font-mono max-h-96'
                       } %>
        </div>

        <%= ff.input :payload_event,
                     as: :text,
                     input_html: {
                       rows: 18,
                       value: JSON.pretty_generate(ff.object.payload_event),
                       class: 'font-mono max-h-96'
                     } %>
      </div>
    <% end %>
  <% end %>

  <%= f.button :submit %>
<% end %>
