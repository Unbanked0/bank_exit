- show_label = defined?(with_label) ? with_label : true

details.dropdown.dropdown-end
  summary.cursor-pointer data-controller="hotkey" data-action="keydown.l@document->hotkey#click"
    = emoji_by_locale(I18n.locale)
    =< hotkey_label('l', size: 'xs')

  ul.menu.dropdown-content.w-max
    - I18n.available_locales.each do |locale|
      - next if locale == I18n.locale
      li
        = link_to url_for(locale: locale.to_s, params: request.query_parameters), role: :menuitem, hreflang: locale.to_s, rel: 'alternate' do
          span
            = emoji_by_locale(locale)
            - if show_label
              span.ml-1=< Rails.configuration.i18n_human_languages[locale]
