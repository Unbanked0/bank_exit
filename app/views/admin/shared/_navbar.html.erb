<div class="navbar bg-base-200 border-b border-base-300 sticky top-0 z-30">
  <div class="flex-none lg:hidden">
    <label for="admin-drawer" class="btn btn-square btn-ghost">
      <%= lucide_icon "menu" %>
    </label>
  </div>

  <div class="flex-1 ml-2 flex items-center gap-2">
    <span class="text-xl font-semibold"><%= yield :page_title %></span>

    <%= yield :page_title_extra %>
  </div>

  <div class="indicator mr-3">
    <span class="indicator-item badge badge-secondary badge-xs top-2 right-2">
      <%= bell_counter.values.compact_blank.count %>
    </span>

    <button
      class="btn btn-ghost btn-circle"
      popovertarget="popover-bell"
      style="anchor-name:--anchor-bell"
    >
      <%= lucide_icon "bell" %>
    </button>

    <ul
      class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm"
      popover
      id="popover-bell"
      style="position-anchor:--anchor-bell"
    >
      <% if bell_counter[:deleted_merchants] == true %>
        <li>
          <%= link_to admin_merchants_path(show_deleted: true) do %>
            <%= t('admin.sidebar.merchants_disabled') %>
          <% end %>
        </li>
      <% end %>

      <% if bell_counter[:flagged_comments] == true %>
        <li>
          <%= link_to admin_comments_path(show_flagged: true) do %>
            <%= t('admin.sidebar.comments_disabled') %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="flex-none gap-3">
    <button
      class="btn btn-ghost pl-0 rounded-full max-md:btn-circle"
      popovertarget="popover-user-menu"
      style="anchor-name:--anchor-user-menu"
    >
      <div class="avatar">
        <div class="w-10 rounded-full">
          <div class="btn btn-circle <%= color_for_role(current_user.role).join(' ') %> uppercase">
            <%= current_user.email_address.first(2) %>
          </div>
        </div>
      </div>

      <div class="hidden md:block ml-1 text-left">
        <div class="font-semibold">
          <%= current_user.email_address.split('@').first %>
        </div>

        <div class="text-xs opacity-60">
          <%= User.human_enum_name(:role, current_user.role) %>
        </div>
      </div>
    </button>

    <ul
      class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm"
      popover
      id="popover-user-menu"
      style="position-anchor:--anchor-user-menu"
    >
      <li>
        <%= link_to t('.edit_my_profile'), edit_admin_profile_path %>
      </li>

      <div class="divider my-1"></div>

      <li>
        <%= link_to t('logout'),
                    session_path,
                    data: { turbo_method: :delete } %>
      </li>
    </ul>
  </div>
</div>
