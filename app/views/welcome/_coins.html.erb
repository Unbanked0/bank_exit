<div class="hero bg-fixed bg-banner-liberty">
  <div class="hero-overlay"></div>

  <div class="hero-content py-20">
    <div class="max-w-5xl space-y-8">
      <header class="text-center space-y-5">
        <h2 class="text-3xl font-bold"><%= t('.title') %></h2>
        <p class="text-lg"><%= t('.headline') %></p>
      </header>

      <div class="grid grid-cols-2 lg:grid-cols-5 gap-6">
        <%= render coins %>
      </div>

      <%= turbo_frame_tag :coin %>
    </div>
  </div>
</div>
