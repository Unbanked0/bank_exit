<% image = @project.cover? ? image_url(@project.cover) : default_image_url

set_meta_tags og: { type: 'article', image: image },
              twitter: { image: image } %>

<% content_for :header_actions do %>
  <div class="flex items-center justify-center gap-5 print:hidden">
    <%= render 'application/actions/share_by_email',
               subject: t('blogs.show.subject', title: @project.title),
               body: t('blogs.show.body', link: tutorial_url(@project.identifier)) %>

    <%= render 'application/actions/print_me' %>
  </div>
<% end %>

<% content_for :footer_actions do %>
  <script type="application/ld+json">
    <%= json_escape(schema_dot_org_project(@project).to_json).html_safe %>
  </script>
<% end %>

<%= render 'articles/wrapper',
           article: @project,
           previous_article: @previous_project,
           next_article: @next_project %>
