<%# locals: (f:) %>

<div class="<%= class_names('nested-fields relative card bg-base-200', 'opacity-50': !f.object.enabled?) %>">
  <div class="card-body">
    <%= f.input :id,
                as: :hidden,
                wrapper: false %>

    <%= f.input :_destroy,
                as: :hidden,
                wrapper: false %>

    <div class="flex flex-col items-center gap-3">
      <%= f.input :url %>
      <%= f.input :title %>

      <%= f.input :enabled,
                  as: :boolean unless f.object.weblinkable.requested_by_user? %>
    </div>
  </div>

  <div class="remove-link-wrapper absolute top-2 right-2">
    <%= button_tag lucide_icon('x'),
                   class: 'btn btn-square btn-xs btn-error',
                   data: {
                     action: "click->nested-form#removeAssociation"
                   } %>
  </div>
</div>
