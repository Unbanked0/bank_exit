<%= simple_form_for '',
  url: pretty_map_path(
    zoom: params[:zoom],
    lat: params[:lat],
    lon: params[:lon]
  ),
  id: 'merchants_filter',
  method: :get,
  html: { class: 'space-y-2' },
  data: {
    controller: 'map--filter',
    map__filter_highlight_class: 'select-primary',
    search_target: 'form',
    turbo_stream: true
  } do |f| %>
  <div class="flex items-center gap-2">
    <%= f.input :search,
      label: false,
      input_html: {
        autocomplete: 'off',
        value: params[:search],
        placeholder: t('simple_form.placeholders.map.search'),
        data: {
          map__filter_target: 'input'
        }
      },
      wrapper: false %>

    <span
      class="btn btn-xs btn-circle btn-primary"
      tabindex="0"
      title="<%= t('.clear_search_query') %>"
      role="button"
      data-action="click->map--filter#clearField keyup.enter->map--filter#clearField"
      data-resetable="search"
    >
      <%= lucide_icon 'undo', class: 'p-1' %>
    </span>
  </div>

  <div class="flex items-center gap-2">
    <div class="w-full">
      <%= f.input :country,
        wrapper: false,
        label: false,
        format: :with_flag,
        priority: %w[GB FR DE ES IT],
        only: Merchant.pluck(:country).uniq,
        selected: params[:country],
        include_blank: :translate,
        input_html: {
          autocomplete: true,
          data: {
            map__filter_target: 'input select'
          },
          class: 'select w-full'
        } %>
    </div>

    <span
      class="btn btn-xs btn-circle btn-primary"
      tabindex="0"
      title="<%= t('.clear_search_country') %>"
      role="button"
      data-action="click->map--filter#clearField keyup.enter->map--filter#clearField"
      data-resetable="country"
    >
      <%= lucide_icon 'undo', class: 'p-1' %>
    </span>
  </div>

  <div class="flex items-center gap-2">
    <div class="w-full">
      <%= f.input :continent,
        label: false,
        collection: merchant_continents_select_helper,
        selected: params[:continent],
        include_blank: :translate,
        input_html: {
          data: {
            map__filter_target: 'input select'
          }
        } %>
    </div>

    <span
      class="btn btn-xs btn-circle btn-primary"
      tabindex="0"
      title="<%= t('.clear_search_continent') %>"
      role="button"
      data-action="click->map--filter#clearField keyup.enter->map--filter#clearField"
      data-resetable="continent"
    >
      <%= lucide_icon 'undo', class: 'p-1' %>
    </span>
  </div>

  <div class="flex items-center justify-between gap-2">
    <div class="space-y-2 w-full">
      <% category_scope = 'categories' %>
      <% category_group_title_scope = 'simple_form.labels.map.category' %>

      <select
        class="select w-full"
        name="category"
        data-map--filter-target="input select"
        data-action="change->map--filter#syncQuickCategories"
      >
        <option value="">
          <%= t('all', scope: category_group_title_scope) %>
        </option>

        <% {
          catering: %w[restaurant bar cafe grocery bakery pastry farm],
          store: %w[supermarket clothes],
          aesthetic: %w[hairdresser beauty massage],
          craft: %w[jewelry handicraft],
          health: %w[doctor dentist optician ophthalmology midwife nurse pharmacy psychiatry],
          financial: %w[atm bank exchange],
          other: %w[hotel tourism telecommunication mobile_phone]
        }.each do |group, categories| %>
          <optgroup label="<%= t(group, scope: category_group_title_scope) %>">
            <% categories.each do |category| %>
              <option
                value="<%= category %>"
                <% if params.dig(:category) == category %>
                  selected
                <% end %>
              >
                <%= t(category, scope: category_scope) %>
              </option>
            <% end %>
          </optgroup>
        <% end %>
      </select>

      <div class="@container">
        <ul class="grid gap-2 grid-cols-2 @md:grid-cols-4">
          <% %i[bar cafe restaurant grocery].each do |category| %>
            <li>
              <input
                type="checkbox"
                id="<%= category %>-option"
                value="<%= category %>"
                name="category"
                class="sr-only peer"
                data-map--filter-target="input"
                data-action="change->map--filter#syncSelectCategories"
                <% if params[:category] == category.to_s %>
                  checked
                <% end %>
              >

              <label
                class="
                  pretty-checkbox flex flex-col items-center justify-center
                  gap-2 peer-focus:outline-2 peer-focus:outline-offset-2
                "
                for="<%= category %>-option"
              >
                <%= merchant_icon_svg icon_for_category(category), width: 50, height: 50 %>

                <div class="text-xs 3xl:text-base wrap-anywhere text-center">
                  <%= t("categories.#{category}") %>
                </div>
              </label>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <span
      class="btn btn-xs btn-circle btn-primary"
      tabindex="0"
      title="<%= t('.clear_search_category') %>"
      role="button"
      data-action="click->map--filter#clearField keyup.enter->map--filter#clearField click->map--filter#syncQuickCategories keyup.enter->map--filter#syncQuickCategories"
      data-resetable="category"
    >
      <%= lucide_icon 'undo', class: 'p-1' %>
    </span>
  </div>

  <div class="flex items-center gap-2 @container">
    <ul class="grid gap-2 grid-cols-1 w-full @lg:grid-cols-3">
      <% Setting::MERCHANTS_FILTER_COINS.each do |coin| %>
        <li class="flex flex-col items-center justify-start gap-2">
          <div class="w-full">
            <input
              type="checkbox"
              id="<%= coin %>-option"
              value="<%= coin %>"
              name="coins[]"
              class="sr-only peer"
              data-map--filter-target="input"
              <% if params.dig(:coins)&.include?(coin.to_s) %>
                checked
              <% end %>
            >

            <label
              class="
                pretty-checkbox flex flex-col xl:flex-row items-center
                justify-center gap-1 peer-focus:outline-2
                peer-focus:outline-offset-2
              "
              for="<%= coin %>-option"
            >
              <div class="avatar-group -space-x-4">
                <% if coin == :bitcoin %>
                  <div class="avatar">
                    <div class="w-10">
                      <%= image_tag 'coins/logo-lightning.svg', alt: 'Logo Lightning' %>
                    </div>
                  </div>
                <% end %>

                <div class="avatar">
                  <div class="w-10">
                    <%= image_tag "coins/logo-#{coin}.svg", alt: "Logo #{coin}" %>
                  </div>
                </div>
              </div>

              <div class="text-xs 3xl:text-base">
                <%= coin.capitalize %>
              </div>
            </label>
          </div>
        </li>
      <% end %>
    </ul>

    <span
      class="btn btn-xs btn-circle btn-primary"
      tabindex="0"
      title="<%= t('.clear_search_coins') %>"
      role="button"
      data-action="click->map--filter#clearField keyup.enter->map--filter#clearField"
      data-resetable="coins"
    >
      <%= lucide_icon 'undo', class: 'p-1' %>
    </span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 fieldset">
    <%= f.input :onchain_only,
                as: :boolean,
                boolean_style: :inline,
                include_hidden: false,
                wrapper: false,
                input_html: {
                  checked: params[:onchain_only] == '1',
                  data: {
                    map__filter_target: 'input'
                  }
                },
                label: t('simple_form.labels.map.onchain_only') %>

    <%= f.input :no_kyc,
                as: :boolean,
                boolean_style: :inline,
                include_hidden: false,
                wrapper: false,
                input_html: {
                  checked: params[:no_kyc] == '1',
                  data: {
                    map__filter_target: 'input'
                  }
                },
                label: t('simple_form.labels.map.no_kyc_html') %>

    <%= f.input :delivery,
                as: :boolean,
                boolean_style: :inline,
                include_hidden: false,
                wrapper: false,
                input_html: {
                  checked: params[:delivery] == '1',
                  data: {
                    map__filter_target: 'input'
                  }
                },
                label: t('simple_form.labels.map.delivery') %>

    <%= f.input :order_by_survey,
                as: :boolean,
                boolean_style: :inline,
                include_hidden: false,
                wrapper: false,
                input_html: {
                  checked: params[:order_by_survey] == '1',
                  data: {
                    map__filter_target: 'input'
                  }
                },
                label: t('simple_form.labels.map.order_by_survey') %>
  </div>

  <noscript>
    <%= f.button :submit, t('search'), class: 'mt-2' %>
  </noscript>
<% end %>
