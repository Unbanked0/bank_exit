<div class="flex flex-col items-center justify-center gap-3">
  <%= link_to coin_path(id: coin.identifier),
            class: 'avatar mx-auto',
            data: { turbo_stream: true } do %>
    <div
      class="
        ring-offset-transparent w-24 rounded-full ring-2 ring-offset-2
        hover:ring-primary motion-safe:transition-colors
      "
    >
      <%= image_tag coin.image,
                title: coin.name,
                alt: "Logo for #{coin.name}",
                loading: :lazy %>
    </div>
  <% end %>

  <div class="text-center">
    <h3 class="font-semibold text-lg"><%= coin.name %></h3>
    <p class="opacity-60"><%= coin.usage %></p>
  </div>
</div>
