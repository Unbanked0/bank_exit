- link_klass = "block w-full p-2 space-y-3 border-l-4 hover:border-l-primary hover:text-inherit! focus-visible:outline-none focus-visible:border-l-primary rounded-none"

ul.overflow-y-auto.divide-y.divide-base-content/20.motion-safe:scroll-smooth.scroll-py-2 class="max-h-[58svh]"
  - if defined?(directories) && directories.present?
    - directories.each do |directory|
      li
        = link_to directory_path(directory),
                  class: "#{link_klass} border-l-secondary" do
          .flex.items-center.justify-between
            .flex.items-center.gap-2.font-medium.text-base
              = render 'logo_or_initials', model: directory, mode: :small

              h3= highlight(directory.name, params[:query])

            == coins_list(directory.coin_wallets.map(&:coin), with_logo: true, with_name: false, size: 'w-5', inline: true)

          - if directory.description.present?
            .truncate.text-sm.mt-2
              = highlight(directory.description, params[:query])

  - merchants.each do |merchant|
    li
      = link_to merchant_path(merchant),
                class: "#{link_klass} border-l-transparent",
                data: { turbo_frame: :_top } do
        .flex.items-center.justify-between
          .flex.items-center.gap-2.font-medium.text-base
            = render 'logo_or_initials', model: merchant, mode: :small

            div
              p.flex.items-center.gap-2
                span
                  = highlight(merchant.name, params[:query])

                - if merchant.category.present?
                  span.badge.badge-xs.badge-secondary
                    = merchant.friendly_category

                - outdated_level = merchant.outdated_level
                - icon_class = 'w-3.5 h-3.5'

                - if outdated_level == :unknown
                  = lucide_icon 'shield-question-mark', class: 'w-3.5 h-3.5'

                - else
                  - if outdated_level == :soft
                    = lucide_icon 'check-check', class: "#{icon_class} text-success"
                  - elsif outdated_level == :medium
                      = lucide_icon 'triangle-alert', class: "#{icon_class} text-warning"
                  - elsif outdated_level == :hard
                      = lucide_icon 'triangle-alert', class: "#{icon_class} text-error"


              p.italic.text-xs.text-base-content/70
                = highlight(merchant.full_address_with_country(expanded: false, inline: true), params[:query])

          == coins_list(merchant.coins, with_logo: true, with_name: false, size: 'w-5', inline: true)

        - if merchant.description.present?
          .text-sm.truncate
            = highlight(merchant.description, params[:query])

  - if merchants.empty? && directories.empty?
    .flex.flex-col.items-center.justify-center.text-base-content/40.py-5.gap-2
      = lucide_icon 'store', class: 'w-20 h-auto'
      p.text-lg= t('empty_results')

- if defined?(pagy) && pagy.count > pagy.limit
  .p-2 data-controller="pagination"
    == pagy_nav(pagy, anchor_string: 'data-turbo-stream="true"')

- unless merchants.empty?
  hr.border-base-content/20

  footer.p-2.text-xs.flex.items-center.justify-between
    p.badge.badge-secondary.badge-xs
      = Directory.model_name.human.capitalize
    p.hide-on-touch.flex.items-center.gap-2
      span
        == hotkey_label('tab', size: 'xs')
        =< t('or')
        ==< hotkey_label(['shift', 'tab'], size: 'xs')
        =< t('.to_navigate')

      span
        ==< hotkey_label('esc', size: 'xs')
        =< t('.to_close_modal')
