<div class="px-5 py-10 lg:p-20 bg-base-300">
  <div class="max-w-5xl space-y-5 mx-auto">
    <header class="text-center">
      <h2 class="text-3xl font-bold"><%= t('statistics.show.title') %></h2>
    </header>

    <%= render 'statistics/statistics_numbers',
               merchants_statistics: merchants_statistics,
               countries_statistics: countries_statistics,
               coins_statistics: coins_statistics,
               categories_statistics: categories_statistics %>

    <p class="text-center lg:text-right">
      <%= link_to t('.see_all_statistics'), statistics_path, class: 'btn btn-primary' %>
    </p>
  </div>
</div>
