<div class="fab print:hidden">
  <div
    title="<%= current_user.email_address %>"
    tabindex="0"
    role="button"
    class="btn btn-lg btn-circle <%= color_for_role(current_user.role).join(' ') %> uppercase"
    data-controller="hotkey"
    data-action="keydown.z@document->hotkey#click"
  >
    <%= current_user.email_address.first(2) %>
  </div>

  <div class="fab-close">
    <span class="badge"><%= t('close') %></span>

    <span class="btn btn-circle btn-lg btn-error">✕</span>
  </div>

  <div>
    <span class="badge"><%= t('application.nav.admin_area') %></span>

    <%= link_to admin_root_path, class: "btn btn-lg btn-circle btn-success" do %>
      <%= lucide_icon "lock-keyhole" %>
    <% end %>
  </div>

  <div>
    <span class="badge"><%= t('admin.shared.navbar.edit_my_profile') %></span>

    <%= link_to edit_admin_profile_path, class: "btn btn-lg btn-circle btn-info" do %>
      <%= lucide_icon "user-pen" %>
    <% end %>
  </div>

  <% if true_user != current_user %>
    <div>
      <span class="badge">
        Retour à mon vrai compte
        <span class="opacity-60">(<%= true_user.email_address %>)</span>
      </span>

      <%= link_to stop_impersonating_admin_users_path, data: { turbo_method: :post }, class: "btn btn-lg btn-circle btn-error" do %>
        <%= lucide_icon "user-round-x" %>
      <% end %>
    </div>
  <% end %>

  <div>
    <span class="badge"><%= t('logout') %></span>

    <%= link_to session_path, data: { turbo_method: :delete }, class: "btn btn-lg btn-circle btn-warning" do %>
      <%= lucide_icon "log-out", class: "-rotate-180" %>
    <% end %>
  </div>
</div>
