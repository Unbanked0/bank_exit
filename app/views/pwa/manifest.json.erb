{
  "name": "<%= [I18n.t('seo.default.title', locale: params[:locale]), Rails.env.production? ? nil : Rails.env].compact.join(" - ") %>",
  "description": "<%= I18n.t('seo.default.description', locale: params[:locale]).html_safe %>",
  "start_url": "/<%= params[:locale] %>/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#000",
  "background_color": "#FFF",
  "icons": [
    {
      "purpose": "any",
      "sizes": "512x512",
      "src": "/pwa/app-icon-512.png",
      "type": "image/png"
    },
    {
      "purpose": "maskable",
      "sizes": "512x512",
      "src": "/pwa/app-icon-512-maskable.png",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "/pwa/app-screenshot.jpg",
      "type": "image/jpg",
      "sizes": "2064x1418",
      "form_factor": "wide"
    },
    {
      "src": "/pwa/app-screenshot.jpg",
      "type": "image/jpg",
      "sizes": "2064x1418"
    }
  ]
}
