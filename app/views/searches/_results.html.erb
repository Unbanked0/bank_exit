<%# locals: (merchants:, directories:, projects:, tutorials:, blogs:, pagy:) %>

<% list_item_class = "list-row hover:bg-base-200! hover:text-base-content!" %>

<nav class="list bg-base-100 max-h-[62svh] overflow-y-auto p-2">
  <% if projects.present? %>
    <div class="p-2 text-xs opacity-60 tracking-wide">
      <%== Project.human_count(projects.count, pretty_count: number_with_delimiter(projects.count)) %>
    </div>
    <% projects.each do |project| %>
      <%= link_to project_path(project, q: params[:query]), class: list_item_class, data: { turbo_frame: :_top } do %>
        <% if project.cover? %>
          <%= image_tag project.cover, alt: project.title, class: "object-cover w-10 h-10" %>
        <% else %>
          <div></div>
        <% end %>

        <div>
          <div class="font-semibold text-md">
            <%== highlight(project.title, params[:query]) %>
          </div>

          <% if project.short_description.present? %>
            <p class="list-col-wrap text-xs opacity-70 mt-2">
              <%== sanitize(
                  highlight(
                    project.short_description,
                    params[:query]
                  ),
                  tags: %w[mark]
                ).delete_prefix("\nImportant\n") %>
            </p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if tutorials.present? %>
    <div class="p-2 text-xs opacity-60 tracking-wide">
      <%== Tutorial.human_count(tutorials.count, pretty_count: number_with_delimiter(tutorials.count)) %>
    </div>
    <% tutorials.each do |tutorial| %>
      <%= link_to tutorial_path(tutorial, q: params[:query]), class: list_item_class, data: { turbo_frame: :_top } do %>
        <% if tutorial.cover? %>
          <%= image_tag tutorial.cover, alt: tutorial.title, class: "object-cover w-10 h-10" %>
        <% else %>
          <div></div>
        <% end %>

        <div>
          <div class="font-semibold text-md">
            <%== highlight(tutorial.title, params[:query]) %>
          </div>

          <% if tutorial.level? %>
            <span class="badge badge-xs inline-block <%= tutorial_class_by_level(tutorial.level) %>">
              <%= t("articles.wrapper.#{tutorial.level}") %>
            </span>
          <% end %>

          <% if tutorial.short_description.present? %>
            <p class="list-col-wrap text-xs opacity-70 mt-2">
              <%== sanitize(
                highlight(
                  tutorial.short_description,
                  params[:query]
                ),
                tags: %w[mark]
              ).delete_prefix("\nImportant\n") %>
            </p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if blogs.present? %>
    <div class="p-2 text-xs opacity-60 tracking-wide">
      <%== Blog.human_count(blogs.count, pretty_count: number_with_delimiter(blogs.count)) %>
    </div>
    <% blogs.each do |blog| %>
      <%= link_to blog_path(blog, q: params[:query]), class: list_item_class, data: { turbo_frame: :_top } do %>
        <% if blog.cover? %>
          <%= image_tag blog.cover, alt: blog.title, class: "object-cover w-10 h-10" %>
        <% else %>
          <div></div>
        <% end %>

        <div>
          <div class="font-semibold text-md">
            <%== highlight(blog.title, params[:query]) %>
          </div>

          <% if blog.short_description.present? %>
            <p class="list-col-wrap text-xs opacity-70 mt-2">
              <%== sanitize(
                highlight(
                  blog.short_description,
                  params[:query]
                ),
                tags: %w[mark]
              ).delete_prefix("\nImportant\n") %>
            </p>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if directories.present? %>
    <div class="p-2 text-xs opacity-60 tracking-wide">
      <%== Directory.human_count(directories.count, pretty_count: number_with_delimiter(directories.count)) %>
    </div>
    <% directories.each do |directory| %>
      <%= link_to directory_path(directory, q: params[:query]), class: list_item_class, data: { turbo_frame: :_top } do %>
        <%= render 'logo_or_initials', model: directory, mode: :medium %>

        <div>
          <div class="font-semibold text-md">
            <%== highlight(directory.name, params[:query]) %>
          </div>

          <% if directory.category.present? %>
            <div class="badge badge-secondary badge-xs font-semibold opacity-60">
              <%= t(directory.category, scope: :directories_categories) %>
            </div>
          <% end %>

          <% if directory.description.present? %>
            <p class="list-col-wrap text-xs opacity-70 mt-2">
              <%== highlight(directory.description,
              params[:query]).truncate(100) %>
            </p>
          <% end %>
        </div>

        <%= coins_list(directory.coin_wallets.enabled.map(&:coin), with_logo: true, with_name: false, size: 'w-5', inline: true) %>
      <% end %>
    <% end %>
  <% end %>

  <% if merchants.any? %>
    <div class="p-2 text-xs opacity-60 tracking-wide">
      <%== Merchant.human_count(pagy.count, pretty_count: number_with_delimiter(pagy.count)) %>
    </div>
    <% merchants.each do |merchant| %>
      <%= link_to merchant_path(merchant), class: list_item_class, data: { turbo_frame: :_top } do %>
        <%= render 'logo_or_initials', model: merchant, mode: :small %>

        <div>
          <div class="font-semibold text-md">
            <%== highlight(merchant.name, params[:query]) %>
          </div>

          <% if merchant.category.present? %>
            <div class="badge badge-secondary badge-xs font-semibold opacity-60">
              <%= merchant.friendly_category %>
            </div>
          <% end %>
        </div>

        <% if merchant.description.present? %>
          <p class="list-col-wrap text-xs opacity-70 mt-2">
            <%== highlight(merchant.description,
            params[:query]).truncate(100) %>
          </p>
        <% end %>

        <%= coins_list(merchant.coins, with_logo: true, with_name: false, size: 'w-5', inline: true) %>

        <div class="flex items-center">
          <div class="tooltip tooltip-left">
            <div class="tooltip-content">
              <%== merchant.full_address_with_country %>
            </div>

            <%= pretty_country_html(merchant.country, show_label: false, show_flag: true) %>
          </div>
        </div>

        <div class="flex items-center">
          <% outdated_level = merchant.outdated_level
            icon_class = 'w-5 h-5' %>

          <span
            class="tooltip tooltip-left"
            data-tip="<%= t('merchants.last_survey_on.last_survey_on', date: merchant.last_survey_on ? time_ago_in_words(merchant.last_survey_on) : ": " + t('unknown')) %>"
          >
            <% if outdated_level == :unknown %>
              <%= lucide_icon 'shield-question-mark', class: icon_class %>
            <% else %>
              <% if outdated_level == :soft %>
                <%= lucide_icon 'check-check', class: "#{icon_class} text-success" %>
              <% elsif outdated_level == :medium %>
                <%= lucide_icon 'triangle-alert', class: "#{icon_class} text-warning" %>
              <% elsif outdated_level == :hard %>
                <%= lucide_icon 'triangle-alert', class: "#{icon_class} text-error" %>
              <% end %>
            <% end %>
          </span>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <% if projects.blank? && blogs.blank? && tutorials.blank? && directories.blank? && merchants.blank? %>
    <li>
      <div
        class="
          flex flex-col items-center justify-center text-base-content/40
          py-5 gap-2
        "
      >
        <%= lucide_icon 'store', class: 'w-20 h-auto' %>

        <p class="text-lg"><%= t('empty_results') %></p>
      </div>
    </li>
  <% end %>
</nav>

<%= render 'pagination', pagy: pagy,
                         use_turbo_stream: true,
                         pagination_path: search_path %>
