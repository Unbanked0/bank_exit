<% if figure.image? %>
  <figure class="text-center">
    <%= link_to image_path(figure.image),
                target: :_blank,
                title: strip_tags(figure.caption) do %>
      <%= image_tag figure.image,
                    class: "rounded-lg mx-auto inline-block #{figure.klass if figure.klass?}",
                    alt: figure.alt_image %>
    <% end %>

    <% if figure.caption? %>
      <figcaption class="text-xs text-center italic mt-2">
        <% if content.url? %>
          <%= link_to content.url, target: :_blank do %>
            <%== figure.caption %>
          <% end %>
        <% else %>
          <%== figure.caption %>
        <% end %>
      </figcaption>
    <% end %>
  </figure>
<% elsif figure.video? %>
  <%= render 'articles/video', video: figure.video %>
<% end %>
