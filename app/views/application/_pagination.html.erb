<%# locals: (pagy:, search_path: nil, add_page_to_url: true, keyboard_enabled: 'true', attrs: {}) %>

<% if pagy.count > pagy.limit %>
  <div
    class="flex items-center justify-center gap-2 p-2"
    data-controller="pagination"
    data-pagination-keyboard-enabled-value="<%= keyboard_enabled %>"
    id="<%= ('pagy_top' if defined?(pagy_top) && pagy_top) %>"
  >
    <% if keyboard_enabled && pagy.previous %>
      <%= hotkey_label(['Ctrl', '◀︎'], size: 'xs') %>
    <% end %>

    <%== pagy.series_nav(
        path: search_path,
        anchor_string: [
          'data-turbo-stream="true"',
          ('data-action="click->pagination#addPageToURL"' if add_page_to_url)
        ]
       .join(' ')
       .concat(attrs[:anchor_string] || '')
    ) %>

    <% if keyboard_enabled && pagy.next %>
      <%= hotkey_label(['Ctrl', '▶︎'], size: 'xs') %>
    <% end %>
  </div>
<% end %>
