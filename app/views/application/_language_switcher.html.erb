<%# locals: (show_current_label: true, show_label: true) %>

<div class="flex items-center gap-1">
  <button
    class="btn btn-ghost btn-circle"
    popovertarget="popover-language"
    style="anchor-name:--anchor-language"
    data-controller="hotkey"
    data-action="keydown.l@document->hotkey#click"
  >
    <span class="text-lg"><%= emoji_by_locale(I18n.locale) %></span>

    <% if show_current_label %>
      <span class="mx-1">
        <%= Rails.configuration.i18n_human_languages[locale] %>
      </span>
    <% end %>
  </button>

  <ul
    class="dropdown menu w-52 rounded-box bg-base-100 shadow-sm"
    popover
    id="popover-language"
    style="position-anchor:--anchor-language"
  >
    <% I18n.available_locales.each do |locale| %>
      <% next if locale == I18n.locale %>

      <li>
        <%= link_to url_for(
                      locale: locale.to_s,
                      params: request.query_parameters
                    ),
                    role: :menuitem,
                    hreflang: locale.to_s,
                    rel: 'alternate' do %>
          <span>
            <%= emoji_by_locale(locale) %>

            <% if show_label %>
              <span class="ml-1">
                <%= Rails.configuration.i18n_human_languages[locale] %>
              </span>
            <% end %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%= hotkey_label('l', size: 'xs') %>
</div>
