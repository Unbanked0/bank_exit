<% grocery = projects.find(&:grocery?)
local_groups = projects.find(&:local_groups?)
project = Project.find('accounting', decorate: true)
business_guide_tutorial = Tutorial.find('cryptopayment-for-business')

active_map = params[:controller].in?(%w[maps merchants])
active_project = (params[:controller] == 'projects' && !params[:id].in?(%w[map grocery local_groups])) || params[:id] == 'flyer'
active_article = params[:controller].in?(%w[blogs tutorials]) && params[:id] != 'flyer' && params[:id] != 'accounting' && params[:id] != 'cryptopayment-for-business'
active_other = params[:controller].in?(%w[local_groups collectives ecosystems media statistics]) %>

<div
  id="popover-menu"
  class="
    dropdown lg:dropdown-center rounded-box bg-base-200 max-w-3xl border
    border-base-content/30 w-[97dvw]
  "
  data-controller="research"
  data-research-search-url-value="<%= merchants_path %>"
  popover
  style="position-anchor:--anchor-menu"
>
  <form
    class="flex items-stretch"
    data-action="reset->research#search"
    id="research"
  >
    <div class="relative w-full">
      <input
        type="text"
        autocomplete="false"
        class="
          p-3 w-full bg-base-100 text-lg pl-12 border-b
          border-base-content/30 focus:border-primary peer
          focus-visible:outline-none!
        "
        data-action="input->research#search"
        data-research-target="input"
        name="query"
        placeholder="<%= t('simple_form.placeholders.research.search') %>"
      >

      <%= lucide_icon 'search', class: 'w-8 absolute top-1/2 -translate-y-1/2 left-2 peer-focus:text-primary' %>

      <span
        class="spinner hidden absolute right-2 top-1/2 -translate-y-1/2 z-1"
        data-research-target="spinner"
      >
        <span class="loading loading-spinner w-8 h-8 text-primary"></span>
      </span>
    </div>

    <button
      class="btn h-auto rounded-none btn-primary"
      role="button"
      tabindex="0"
      title="<%= t('maps.filters_form.clear_search_query') %>"
      type="reset"
    >
      <%= lucide_icon 'undo', class: 'p-1' %>
    </button>
  </form>

  <div data-research-target="initialContent" id="menu">
    <div class="grid grid-cols-3 gap-3 px-3 mt-3">
      <%= raw_link_to maps_path,
            class: 'relative block aspect-square overflow-hidden rounded-box hover:text-inherit! group',
            hotkey: '1',
            alt_key: true,
            yield_hotkey: true do %>
        <div
          class="
            absolute inset-0 bg-banner-map bg-cover bg-center filter blur-xs
            group-focus-visible:scale-125 group-hover:scale-125
            motion-safe:transition-transform
          "
        ></div>

        <div class="absolute inset-0 bg-base-100/50"></div>

        <div
          class="
            relative z-10 flex flex-col gap-3 h-full items-center
            justify-center
          "
        >
          <%= lucide_icon 'map', class: 'w-8 h-auto' %>

          <p
            class="
              lg:text-base font-medium leading-tight text-center
              wrap-break-word px-1
            "
          >
            <%= t('.menu.map') %>
          </p>

          <%= content_for(:hotkey) %>
        </div>
      <% end %>

      <%= raw_link_to directories_path,
            class: 'relative block aspect-square overflow-hidden rounded-box hover:text-inherit! group',
            hotkey: '2',
            alt_key: true,
            yield_hotkey: true do %>
        <div
          class="
            absolute inset-0 bg-banner-directories bg-cover bg-center filter
            blur-xs group-focus-visible:scale-125 group-hover:scale-125
            motion-safe:transition-transform
          "
        ></div>

        <div class="absolute inset-0 bg-base-100/50"></div>

        <div
          class="
            relative z-10 flex flex-col gap-3 h-full items-center
            justify-center
          "
        >
          <%= lucide_icon 'notebook', class: 'w-8 h-auto' %>

          <p
            class="
              lg:text-base font-medium leading-tight text-center
              wrap-break-word px-1
            "
          >
            <%= t('application.nav.menu.directories') %>
          </p>

          <%= content_for(:hotkey) %>
        </div>
      <% end %>

      <%= raw_link_to project_path(:grocery),
            class: 'relative block aspect-square overflow-hidden rounded-box hover:text-inherit! group',
            hotkey: '3',
            alt_key: true,
            yield_hotkey: true do %>
        <div
          class="
            absolute inset-0 bg-banner-1 bg-cover bg-center filter blur-xs
            group-focus-visible:scale-125 group-hover:scale-125
            motion-safe:transition-transform
          "
        ></div>

        <div class="absolute inset-0 bg-base-100/50"></div>

        <div
          class="
            relative z-10 flex flex-col gap-3 h-full items-center
            justify-center
          "
        >
          <%= lucide_icon 'store', class: 'w-8 h-auto' %>

          <p
            class="
              lg:text-base font-medium leading-tight text-center
              wrap-break-word px-1
            "
          >
            <%= grocery.title %>
          </p>

          <%= content_for(:hotkey) %>
        </div>
      <% end %>
    </div>

    <ul class="menu main-menu w-full overflow-y-auto p-3 flex-nowrap max-h-127">
      <li>
        <%= raw_link_to root_path,
              hotkey: '0',
              alt_key: true do %>
          <%= t('.menu.home') %>
        <% end %>
      </li>

      <li>
        <%= tag.details(open: active_project) do %>
          <%= tag.summary class: class_names(['text-primary': active_project]) do %>
            <%= t('.menu.projects') %>
          <% end %>

          <%= tag.ul do %>
            <% projects.each do |project| %>
              <% next if project.identifier.in?(%w[map grocery local_groups accounting]) %>

              <%= tag.li do %>
                <%= link_to project.link,
                      class: ('text-primary' if params[:id] == project.identifier),
                      target: (:_blank if project.external?) do %>
                  <%= project.title %>

                  <% if project.external? %>
                    <%= lucide_icon 'square-arrow-out-up-right', class: 'w-4 inline-flex ml-1' %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>

            <%= tag.li do %>
              <%= link_to 'https://coinadoptionscore.com', target: :_blank do %>
                CoinAdoptionScore
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </li>

      <li>
        <%= tag.details(open: active_article) do %>
          <%= tag.summary class: class_names(['text-primary': active_article]) do %>
            <%= t('.menu.articles') %>
          <% end %>

          <%= tag.ul do %>
            <%= tag.li do %>
              <%= link_to blogs_path,
                    class: ('text-primary' if params[:controller] == 'blogs' && params[:id] != 'flyer') do %>
                <%= t('.menu.blogs') %>
              <% end %>
            <% end %>

            <%= tag.li do %>
              <%= link_to tutorials_path,
                    class: ('text-primary' if params[:controller] == 'tutorials') do %>
                <%= t('.menu.tutorials') %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </li>

      <li>
        <%= tag.details(open: active_other) do %>
          <%= tag.summary class: class_names(['text-primary': active_other]) do %>
            <%= t('other') %>
          <% end %>

          <%= tag.ul do %>
            <%= tag.li do %>
              <%= link_to collective_path,
                    class: ('text-primary' if params[:controller] == 'collectives') do %>
                <%= t('collectives.show.title') %>
              <% end %>
            <% end %>

            <%= tag.li do %>
              <%= link_to local_groups_path,
                  class: ('text-primary' if params[:controller] == 'local_groups') do %>
                <%= local_groups.title %>
                <%= inline_svg_tag "contacts/telegram.svg", class: 'inline-flex bg-white text-[#27A7E7] w-5 rounded-full', title: 'Telegram', alt: 'Logo Telegram' %>
              <% end %>
            <% end %>

            <%= tag.li do %>
              <%= link_to media_path,
                  class: ('text-primary' if params[:controller] == 'media') do %>
                <%= t('media.index.title') %>
              <% end %>
            <% end %>

            <%= tag.li do %>
              <%= link_to ecosystem_path,
                  class: ('text-primary' if params[:controller] == 'ecosystems') do %>
                <%= t('ecosystems.show.title') %>
                <%= image_tag icon_by_coin('monero'), class: 'w-5', alt: "Monero" %>
              <% end %>
            <% end %>

            <%= tag.li do %>
              <%= link_to statistics_path,
                  class: ('text-primary' if params[:controller] == 'statistics') do %>
                <%= t('statistics.show.title') %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </li>

      <li>
        <% active_pro = params[:id].in?(%w[accounting cryptopayment-for-business]) %>

        <%= tag.details(open: active_pro) do %>
          <%= tag.summary class: class_names(['text-primary': active_pro]) do %>
            <%= t('.menu.pros') %>

            <%= tag.span class: "status status-primary" do %>
            <% end %>
          <% end %>

          <%= tag.ul do %>
            <%= tag.li do %>
              <%= link_to tutorial_path(business_guide_tutorial.identifier),
                    class: ('text-primary' if params[:id] == 'cryptopayment-for-business') do %>
                <%= business_guide_tutorial.short_title %>
              <% end %>
            <% end %>

            <%= tag.li do %>
              <%= link_to project.link,
                    class: ('text-primary' if params[:id] == 'accounting') do %>
                <%= project.title %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </li>

      <li>
        <%= link_to '#contact' do %>
          <%= t('.menu.contact') %>
        <% end %>
      </li>

      <% if authenticated? %>
        <li>
          <% color = color_for_role(current_user.role) %>

          <details open>
            <summary>
              <div class="avatar avatar-placeholder">
                <div class="w-8 rounded-full uppercase bg-<%= color %> text-<%= color %>-content">
                  <%= current_user.email_address.first(2) %>
                </div>
              </div>

              <span class="text-base-content/50 underline">
                <%= current_user.email_address %>
              </span>
            </summary>

            <ul>
              <li>
                <%= link_to t('.admin_area'), admin_root_path %>
              </li>

              <% if true_user != current_user %>
                <li>
                  <%= link_to t('.back_to_my_account'),
                        stop_impersonating_admin_users_path,
                        data: { turbo_method: :post },
                        class: 'text-warning' %>
                </li>
              <% end %>

              <li>
                <%= link_to t('logout'),
                      session_path,
                      data: { turbo_method: :delete },
                      class: 'text-error' %>
              </li>
            </ul>
          </details>
        </li>
      <% end %>
    </ul>
  </div>

  <footer
    class="
      border-t border-base-content/20 p-2 flex flex-col lg:flex-row
      items-center gap-2 lg:items-end justify-between
    "
  >
    <%= render 'theme_switcher' %>

    <p class="text-xs">
      <% heart = lucide_icon('heart', class: 'h-4 w-4 stroke-red-600 fill-red-600 inline-flex mx-0.5 hover:scale-150 motion-safe:transition-transform') %><%= t('application.footer.developed_by_html', heart: heart) %>
    </p>
  </footer>
</div>
