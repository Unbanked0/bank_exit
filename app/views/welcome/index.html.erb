<div class="hero bg-fixed <%= "bg-banner-#{rand(1..5)}" %>">
  <div class="hero-overlay"></div>

  <div class="hero-content hero-content-main text-center">
    <div class="max-w-max space-y-8">
      <div class="flex flex-col lg:flex-row items-center gap-5 justify-between">
        <figure class="order-3 lg:order-0">
          <% tracks = [ \
              { src: "first_market_gardener_monero.#{I18n.locale}.vtt", srclang: I18n.locale, default: I18n.locale != :fr } \
          ] %>

          <%= video_with_tracks_tag 'first_market_gardener_monero.mp4',
              tracks,
              controls: true,
              autoplay: false,
              class: 'rounded-box mx-auto max-h-[550px] border-4 border-base-content',
              poster: image_path('poster_first_market_gardener_monero.jpg'),
              data: { reload_subtitles: true } %>

          <figcaption class="text-sm mt-1 text-center italic">
            <%= t('.video_caption') %>
          </figcaption>
        </figure>

        <div class="lg:w-1/3 text-center order-1 lg:order-0">
          <%= image_tag logo_by_locale, class: 'w-48 mx-auto mb-3 hover:scale-110 motion-safe:transition-transform', alt: "Logo #{t('.title')}" %>

          <h1 class="text-3xl font-bold mb-6">
            <%= t('.title') %>
          </h1>

          <p class="text-xl"><%= t('.headline') %></p>
        </div>

        <%= render 'questions_form', profiles: @profiles, levels: @levels %>
      </div>
    </div>
  </div>
</div>

<%= render 'debt_clock' %>
<%= render 'coins', coins: @coins %>

<div class="container mx-auto flex flex-col lg:flex-row items-center lg:items-start">
  <%= render 'maps/map', from_welcome: true %>

  <div
    class="
      w-full lg:w-1/2 space-y-3 lg:overflow-y-auto pb-4 lg:border-l
      dark:border-gray-500 p-3 lg:h-[600px]
    "
  >
    <header class="text-center space-y-2">
      <%= link_to maps_path, class: 'text-primary' do %>
        <h2 class="text-3xl"><%= t('.map.title') %></h2>
      <% end %>

      <p class="text-lg"><%= t('.map.subtitle') %></p>

      <div class="alert alert-info">
        <%= t('.map.merchant_highlight_tooltip_html') %>
      </div>
    </header>

    <div class="space-y-3">
      <% @merchants_sample.each do |merchant| %>
        <%= render 'merchants/merchant', merchant: merchant %>
      <% end %>

      <p class="text-center lg:text-right">
        <%= link_to maps_path, class: 'btn btn-success btn-block' do %>
          <%= t('.map.discover_all') %>
        <% end %>
      </p>
    </div>
  </div>
</div>

<%= render 'welcome/statistics',
            statistics_presenter: @statistics_presenter,
            merchants_statistics: @merchants_statistics,
            countries_statistics: @countries_statistics,
            coins_statistics: @coins_statistics,
            categories_statistics: @categories_statistics %>

<%= render 'projects', projects: @projects %>

<% if @highlighted_tutorials %>
  <%= render 'tutorials', highlighted_tutorials: @highlighted_tutorials %>
<% end %>

<%= render template: 'faqs/show' %>

<%# = render 'cbdc' %>
