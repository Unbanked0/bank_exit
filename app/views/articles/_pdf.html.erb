<figure>
  <iframe
    src="<%= content.render.pdf %>"
    class="w-full rounded-lg lg:h-200"
    title="PDF content"
  ></iframe>

  <% if content.render.caption? %>
    <figcaption class="text-xs text-center italic mt-2">
      <% if content.url? %>
        <%= link_to content.url, target: :_blank do %>
          <%== content.render.caption %>
        <% end %>
      <% else %>
        <%== content.render.caption %>
      <% end %>
    </figcaption>
  <% end %>
</figure>
