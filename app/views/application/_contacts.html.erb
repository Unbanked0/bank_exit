<div
  class="focus:aura focus:aura-silver group scroll-mt-20"
  id="contact"
  tabindex="0"
>
  <nav class="bg-base-100 rounded-box group-focus:p-2 motion-safe:transition-[padding]">
    <h2 class="footer-title"><%= t('.title') %></h2>

    <% icon_klass = "w-10 group-focus:text-[var(--contact-color)] group-focus:rounded-full group-focus:bg-white motion-safe:transition-all" %>

    <% contacts.each do |contact| %>
      <% icon_style = "--contact-color: #{contact.color_hex}" %>

      <% if contact.session? || contact.nostr? || contact.email? %>
        <%= link_to contact_path(id: contact.title),
                  title: contact.title,
                  class: 'flex items-center gap-3',
                  data: { turbo_stream: true } do %>
          <% if contact.email? %>
            <%= lucide_icon contact.icon,
                  width: '32',
                  height: '32',
                  class: icon_klass,
                  style: icon_style,
                  alt: contact.title %>
          <% else %>
            <%= inline_svg_tag "contacts/#{contact.icon}",
                  class: icon_klass,
                  style: icon_style,
                  alt: contact.title,
                  loading: :lazy %>
          <% end %>

          <%= clean_url(contact.main_link) %>
        <% end %>
      <% else %>
        <%= link_to contact.main_link,
                  title: contact.title,
                  class: 'flex items-center',
                  target: :_blank do %>
          <div class="flex items-center gap-3">
            <%= inline_svg_tag "contacts/#{contact.icon}",
                  class: icon_klass,
                  style: icon_style,
                  alt: contact.title, loading: :lazy %>

            <%= clean_url(contact.main_link) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </nav>
</div>
