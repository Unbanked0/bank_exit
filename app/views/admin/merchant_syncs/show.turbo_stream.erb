<% max_items = 100 %>
<% show_all = params[:debug] == "true" %>

<%= turbo_stream.update :modal do %>
  <% content_for(:modal_title) do %>
    <% if @merchant_sync.raw_json.attached? %>
      <div class="flex items-center gap-3">
        <%= link_to rails_blob_path(@merchant_sync.raw_json, disposition: "attachment"),
              class: "btn btn-square btn-soft btn-success" do %>
          <%= lucide_icon "file-braces-corner", class: "w-5" %>
        <% end %>

        <%= @merchant_sync.sync? ? "Sync" : "Cleanup" %>
        <%= l(@merchant_sync.started_at) %>
      </div>
    <% else %>
      <%= @merchant_sync.sync? ? "Sync" : "Cleanup" %>
      <%= l(@merchant_sync.started_at) %>
    <% end %>
  <% end %>

  <%= render_modal auto_open: true,
                   modal_size: @merchant_sync.error? ? "max-w-5xl" : "max-w-3xl" do %>
    <% if @merchant_sync.success? || @merchant_sync.success_with_error? %>
      <% if @merchant_sync.with_details? %>
        <% if @merchant_sync.added_merchants_count > 0 %>
          <details class="collapse collapse-arrow bg-base-200 border border-base-300">
            <summary class="collapse-title font-semibold">
              <span class="status status-success"></span>
              <%= MerchantSync.human_attribute_name(:added_merchants_count) %>
              (<%= @merchant_sync.added_merchants_count %>)
            </summary>

            <% if @merchant_sync.added_merchants_count <= max_items || show_all %>
              <pre class="collapse-content json-colorized"><%= auto_link(
                highlight(
                  json_highlight(@merchant_sync.payload_added_merchants),
                  params[:query]
                ),
                link: :urls,
                html: { target: :_blank, rel: "noopener" }
              ) %></pre>
            <% else %>
              <div class="collapse-content">
                <p>
                  Too much new data to display,
                  <%= link_to "read as JSON",
                        admin_merchant_sync_path(@merchant_sync, new: true, format: :json),
                        target: :_blank,
                        rel: "noopener",
                        class: "btn btn-link px-0" %>
                  in your browser.
                </p>
              </div>
            <% end %>
          </details>
        <% end %>
        <% if @merchant_sync.updated_merchants_count > 0 %>
          <details class="collapse collapse-arrow bg-base-200 border border-base-300">
            <summary class="collapse-title font-semibold">
              <span class="status status-warning"></span>

              <%= MerchantSync.human_attribute_name(:updated_merchants_count) %>
              (<%= @merchant_sync.updated_merchants_count %>)
            </summary>

            <% less_than_max = @merchant_sync.updated_merchants_count <= max_items || show_all %>

            <% if less_than_max %>
              <% if @merchant_sync.no_diff? %>
                <% diffy = @merchant_sync.payload_before_updated_merchants %>
                <% diffy = auto_link(
                     json_highlight(diffy),
                     link: :urls,
                     html: { target: :_blank, rel: "noopener" }
                   ) %>
                <pre class="collapse-content json-colorized"><%= params[:query].present? ? highlight(diffy, params[:query]) : diffy %></pre>
              <% else %>
                <% diffy = diffy_json(
                     @merchant_sync.payload_before_updated_merchants.to_json,
                     @merchant_sync.payload_updated_merchants.to_json,
                     highlight: true
                   ) %>
                <% diffy = auto_link(
                     diffy,
                     link: :urls,
                     html: { target: :_blank, rel: "noopener" }
                   ) %>
                <div class="collapse-content json-diff">
                  <%= params[:query].present? ? highlight(diffy, params[:query]) : diffy %>
                </div>
              <% end %>
            <% else %>
              <div class="collapse-content">
                <p>
                  Too much updated data to display,
                  <%= link_to "read as JSON",
                        admin_merchant_sync_path(@merchant_sync, updated: true, format: :json),
                        target: :_blank,
                        rel: "noopener",
                        class: "btn btn-link px-0" %>
                  in your browser.
                </p>
              </div>
            <% end %>
          </details>
        <% end %>
        <% if @merchant_sync.soft_deleted_merchants_count > 0 %>
          <details class="collapse collapse-arrow bg-base-200 border border-base-300">
            <summary class="collapse-title font-semibold">
              <span class="status status-error"></span>

              <% if @merchant_sync.sync? %>
                <%= MerchantSync.human_attribute_name(:soft_deleted_merchants_count) %>
              <% else %>
                <%= MerchantSync.human_attribute_name(:hard_deleted_merchants_count) %>
              <% end %>

              (<%= @merchant_sync.soft_deleted_merchants_count %>)
            </summary>

            <% if @merchant_sync.soft_deleted_merchants_count <= max_items || show_all %>
              <pre class="collapse-content json-colorized"><%= auto_link(
                json_highlight(@merchant_sync.payload_soft_deleted_merchants),
                html: { target: :_blank, rel: "noopener" }
              ) %></pre>
            <% else %>
              <div class="collapse-content">
                <p>
                  Too much deleted data to display,
                  <%= link_to "read as JSON",
                        admin_merchant_sync_path(@merchant_sync, deleted: true, format: :json),
                        target: :_blank,
                        rel: "noopener",
                        class: "btn btn-link px-0" %>
                  in your browser.
                </p>
              </div>
            <% end %>
          </details>
        <% end %>
        <% if @merchant_sync.payload_countries.count > 0 %>
          <details class="collapse collapse-arrow bg-base-200 border border-base-300">
            <summary class="collapse-title font-semibold">
              <span class="status"></span>
              <%= MerchantSync.human_attribute_name(:payload_countries) %>
            </summary>

            <pre class="collapse-content json-colorized"><%= json_highlight(@merchant_sync.payload_countries) %></pre>
          </details>
        <% end %>
        <% if @merchant_sync.nostr_event? %>
          <details class="collapse collapse-arrow bg-base-200 border border-base-300">
            <summary class="collapse-title font-semibold">
              <span class="status status-info"></span>
              Nostr payload
            </summary>

            <pre class="collapse-content json-colorized"><%= json_highlight(@merchant_sync.nostr_event.payload_response) %></pre>

            <div class="divider"></div>

            <pre class="collapse-content json-colorized"><%= json_highlight(@merchant_sync.nostr_event.payload_event) %></pre>
          </details>
        <% end %>
      <% else %>
        <p class="italic text-center my-2">
          No update to show
        </p>
      <% end %>
    <% end %>

    <% if @merchant_sync.merchant_sync_steps.any? %>
      <div class="mockup-code">
        <%= render @merchant_sync.merchant_sync_steps %>
      </div>
    <% end %>

    <% if @merchant_sync.error? || @merchant_sync.success_with_error? %>
      <% @merchant_sync.merchant_sync_steps.error.each do |step| %>
        <details class="collapse collapse-arrow bg-error/10 border border-error/30">
          <summary class="collapse-title font-semibold">
            <span class="status status-error"></span>
            <%= step.message_for_step %>
          </summary>

          <pre class="collapse-content json-colorized"><%= json_highlight(step.payload_error) %></pre>
        </details>
      <% end %>
    <% end %>
  <% end %>
<% end %>
