<footer class="<%= class_names(["bg-base-200 text-base-content p-5 lg:p-10 border-base-content/10 border-t print:hidden", 'snow-stack': themes_finder.christmas_time?]) %>">
  <% unless params[:controller] == 'risks' %>
    <details
      class="
        collapse collapse-arrow bg-info text-info-content mx-auto mb-10
        container lg:w-1/2!
      "
    >
      <summary class="collapse-title font-semibold text-center">
        <%= t('.warning_title') %>
      </summary>

      <div class="collapse-content space-y-2">
        <%= t('risks.index.body_html') %>
      </div>
    </details>
  <% end %>

  <div class="container mx-auto footer lg:place-content-evenly sm:footer-horizontal">
    <nav>
      <h2 class="footer-title">
        <%= t('application.nav.collectif') %> <%= t('application.nav.bank_exit') %>
      </h2>

      <div class="hide-on-touch flex items-center gap-2">
        <button
          aria-label="Help modal"
          class="
            block cursor-pointer hover:text-primary
            motion-safe:transition-colors
          "
          commandfor="modal_help"
          command="show-modal"
        >
          <%= lucide_icon 'circle-question-mark', class: 'w-4 inline-flex' %>
          <%= t('help') %>
        </button>

        <p class="hide-on-touch">
          <%= hotkey_label(['shift', '?'], size: 'xs') %>
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          aria-label="About modal"
          class="
            block cursor-pointer hover:text-primary
            motion-safe:transition-colors
          "
          commandfor="modal_about"
          command="show-modal"
        >
          <%= lucide_icon 'info', class: 'w-4 inline-flex' %>
          <%= t('about') %>
        </button>

        <p class="hide-on-touch">
          <%= hotkey_label(['ctrl', 'i'], size: 'xs') %>
        </p>
      </div>

      <%= link_to 'https://bank-exit-uptime-production.up.railway.app/status/bank-exit',
                  class: 'block',
                  target: :_blank do %>
        <div class="inline-grid mr-1 *:[grid-area:1/1]">
          <div class="status status-success motion-safe:animate-ping"></div>
          <div class="status status-success"></div>
        </div>

        <%= t('status') %>
      <% end %>

      <% if themes_finder.christmas_time? %>
        <%= render 'snowflakes' %>
      <% end %>

      <% unless authenticated? %>
        <%= link_to '.', new_session_path %>
      <% end %>

      <%= image_tag 'logo_by_mondetta.jpeg', class: 'w-32 mx-auto rounded-full mt-4', title: 'Logo by Mondetta', alt: 'Logo by Mondetta' %>
    </nav>

    <nav>
      <h2 class="footer-title">
        <%= t('.navigation') %>
      </h2>

      <%= link_to t('application.nav.menu.home'), root_path %>

      <%= link_to collective_path do %>
        <%= t('collectives.show.title') %>
      <% end %>

      <%= link_to directories_path do %>
        <%= Directory.model_name.human.capitalize %>
      <% end %>

      <%= link_to t('application.nav.menu.blogs'), blogs_path %>
      <%= link_to t('application.nav.menu.tutorials'), tutorials_path %>
      <%= link_to t('media.index.title'), media_path %>
      <%= link_to t('application.nav.menu.faq'), faq_path %>
      <%= link_to t('glossaries.show.title'), glossaries_path %>

      <%= link_to statistics_path do %>
        <%= t('statistics.show.title') %>
      <% end %>

      <%= link_to license_path, target: :_blank do %>
        <%= t('.license') %>
      <% end %>
    </nav>

    <nav>
      <h2 class="footer-title"><%= t('.projects') %></h2>

      <% projects.each do |project| %>
        <%= link_to project.link, target: (:_blank if project.external?) do %>
          <%= project.title %>

          <% if project.identifier == 'local_groups' %>
            <%= inline_svg_tag "contacts/telegram.svg", class: 'inline-flex ml-2 bg-white rounded-full text-[#27A7E7] w-5', title: 'Telegram', alt: 'Logo Telegram' %>
          <% end %>

          <% if project.external? %>
            <%= lucide_icon 'square-arrow-out-up-right', class: 'w-4 inline-flex ml-1' %>
          <% end %>
        <% end %>
      <% end %>
    </nav><%= render 'application/contacts', contacts: contacts %>
  </div>
</footer>

<footer
  class="
    container mx-auto footer bg-base-100 text-base-content
    border-base-content/10 border-t lg:px-10 p-4 justify-center
    lg:justify-start print:hidden
  "
>
  <aside>
    <div
      class="
        grid grid-cols-1 lg:grid-flow-col items-center text-center
        lg:text-left gap-4
      "
    >
      <%= image_tag logo_by_locale, class: 'w-16 h-16 mx-auto object-cover rounded-full', alt: 'Logo Bank-Exit' %>

      <p>
        <%= t('.copyright_html', year: Date.current.year) %>

        <br>

        <% heart = lucide_icon('heart', class: 'h-5 w-5 stroke-red-600 fill-red-600 inline-flex mx-0.5 hover:scale-150 motion-safe:transition-transform') %>
        <%= t('.developed_by_html', heart: heart) %>
      </p>
    </div>
  </aside>
</footer>
