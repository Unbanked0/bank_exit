<div class="card max-w-lg mx-auto bg-base-200 lg:my-10 rounded-box">
  <div class="card-body space-y-5">
    <%= simple_form_for [:admin, user],
                        html: { class: 'space-y-5' } do |f| %>
      <% if user.errors.any? %>
        <div class="alert alert-error">
          <ul class="list-disc list-inside">
            <% user.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.input :email_address %>
      <%= f.input :password %>
      <%= f.input :password_confirmation %>

      <%= f.input :role,
                  collection: user_roles_select_helper,
                  include_blank: false %>

      <%= f.input :enabled %>
      <%= f.button :submit %>
    <% end %>
  </div>
</div>
