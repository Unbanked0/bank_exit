<% content_for :header_actions do %>
  <div class="flex items-center justify-center gap-5 print:hidden">
    <%= render 'application/actions/share_by_email',
               subject: t('blogs.show.subject', title: @blog.title),
               body: t('blogs.show.body', link: tutorial_url(@blog.identifier)) %>

    <%= render 'application/actions/print_me' %>
  </div>
<% end %>

<% content_for :footer_actions do %>
  <script type="application/ld+json">
    <%= json_escape(schema_dot_org_blog(@blog).to_json).html_safe %>
  </script>

  <script type="application/ld+json">
    <%= json_escape(schema_dot_org_breadcrumb_blog(@blog).to_json).html_safe %>
  </script>
<% end %>

<%= render 'articles/wrapper', article: @blog %>
