    alert alert-warning alert-vertical place-items-center justify-center
    text-center
  "
>
  <p>
    Vous êtes actuellement connecté en tant que
    <strong><%= current_user.email_address %></strong> (
    <%= User.human_enum_name(:role, current_user.role) %>)
  </p>

  <p>
    Pour revenir à votre tableau de bord, veuillez cliquer sur le lien suivant:
  </p>

  <%= button_to 'Retour à mon vrai compte', stop_impersonating_admin_users_path, class: 'underline cursor-pointer' %>
</div>
