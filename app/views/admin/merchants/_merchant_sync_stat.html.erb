<div id="merchant_sync_stat" class="stat space-y-3">
  <% if merchant_sync %>
    <% if merchant_sync.success? || merchant_sync.success_with_error? %>
      <div
        class="stat-figure tooltip tooltip-bottom <%= merchant_sync.success? ? 'tooltip-success' : 'tooltip-warning' %>"
        data-tip="<%= MerchantSync.human_enum_name(:status, merchant_sync.status) %>"
      >
        <%= link_to admin_merchant_sync_path(merchant_sync),
                    data: { turbo_stream: true } do %>
          <%= lucide_icon 'check-check',
                          class: "w-12 h-12 #{merchant_sync.success? ? 'text-success' : 'text-warning'}" %>
        <% end %>
      </div>
    <% elsif merchant_sync.error? %>
      <div
        class="stat-figure tooltip tooltip-error tooltip-bottom"
        data-tip="<%= MerchantSync.human_enum_name(:status, merchant_sync.status) %>"
      >
        <%= link_to admin_merchant_sync_path(merchant_sync),
                    data: { turbo_stream: true } do %>
          <%= lucide_icon 'triangle-alert', class: 'w-12 h-12 text-error' %>
        <% end %>
      </div>
    <% else %>
      <div
        class="stat-figure tooltip tooltip-bottom"
        data-tip="<%= MerchantSync.human_enum_name(:status, merchant_sync.status) %>"
      >
        <%= lucide_icon 'refresh-cw', class: 'w-12 h-12 animate-rotating' %>
      </div>
    <% end %>
  <% else %>
    <div class="stat-figure">
      <%= lucide_icon 'refresh-cw', class: 'w-12 h-12' %>
    </div>
  <% end %>

  <div class="stat-title">
    <span class="status status-info status-lg"></span>
    <%= t('.last_update') %>
  </div>

  <% if merchant_sync %>
    <% if merchant_sync.pending? %>
      <div
        class="stat-value text-lg"
        title="<%= l(merchant_sync.started_at) %>"
      >
        <%= t('.there_is', time: time_ago_in_words(merchant_sync.started_at)) %>
      </div>
    <% elsif merchant_sync.ended_at.present? %>
      <div class="stat-value text-lg" title="<%= l(merchant_sync.ended_at) %>">
        <%= t('.there_is', time: time_ago_in_words(merchant_sync.ended_at)) %>
      </div>
    <% end %>
  <% else %>
    <div class="stat-value text-lg">
      --
    </div>
  <% end %>

  <div class="stat-actions flex items-center gap-2">
    <% if merchant_sync %>
      <% if merchant_sync.pending? %>
        <div class="badge badge-soft badge-sm animate-pulse">
          <%= MerchantSync.human_enum_name(:status, merchant_sync.status) %>
        </div>
      <% else %>
        <%= render 'admin/merchant_syncs/refresh_button',
                   disabled: !can_refresh_merchants?(merchant_sync) %>
      <% end %>
    <% else %>
      <%= render 'admin/merchant_syncs/refresh_button',
                 disabled: false %>
    <% end %>

    <% if Merchant.by_country(nil).any? %>
      <%= button_to admin_merchants_assign_countries_path,
                    class: 'btn btn-info btn-xs',
                    data: {
                      controller: 'hotkey',
                      action: 'keydown.f@document->hotkey#click',
                      turbo_confirm: t('.assign_countries_confirm_html')
                    } do %>
        <%= lucide_icon 'flag', class: 'w-3 h-3' %>
        <%= t('.assign_countries') %>
        <%= hotkey_label('f', size: 'xs') %>
      <% end %>
    <% end %>
  </div>
</div>
