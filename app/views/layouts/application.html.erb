<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <%= seo_meta_tags(@pagy) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta content="light dark" name="color-scheme">

    <meta
      content="#f7f4f5"
      media="(prefers-color-scheme: light)"
      name="theme-color"
    >

    <meta
      content="#282a36"
      media="(prefers-color-scheme: dark)"
      name="theme-color"
    >

    <%= yield :head %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= stylesheet_link_tag 'https://unpkg.com/leaflet@2.0.0-alpha.1/dist/leaflet.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/leaflet-gesture-handling@1.2.2/dist/leaflet-gesture-handling.min.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/leaflet.fullscreen/dist/Control.FullScreen.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/@kristjan.esperanto/leaflet.markercluster@3/dist/MarkerCluster.css' %>
    <%= stylesheet_link_tag 'https://unpkg.com/@kristjan.esperanto/leaflet.markercluster@3/dist/MarkerCluster.Default.css' %>

    <%= stylesheet_link_tag :app %>

    <%= render 'initial_javascript' %>
    <%= javascript_importmap_tags %>

    <%= debugbar_head if defined?(Debugbar) %>

    <script type="application/ld+json">
      <%= json_escape(schema_dot_org_organization.to_json).html_safe %>
    </script>
  </head>

  <body
    class="max-w-screen-3xl mx-auto"
    data-controller="theme"
    data-theme-light-value="<%= @themes[:light] %>"
    data-theme-dark-value="<%= @themes[:dark] %>"
  >
    <main>
      <%= render 'header',
                 projects: @projects,
                 tutorials: @tutorials,
                 highlighted_tutorials: @highlighted_tutorials,
                 bitcoin_tutorial: @bitcoin_tutorial,
                 monero_tutorial: @monero_tutorial %>

      <%= render "search" %>

      <%= yield %>

      <%= render 'footer', projects: @projects, contacts: @contacts, themes_finder: @themes_finder %>
    </main>

    <%= turbo_frame_tag :announcements, src: announcements_path %>

    <div id="modal"></div>
    <%= render 'application/modal', id: 'turbo-confirm' %>
    <%= render 'modal_help' %>
    <%= render 'modal_about' %>

    <%= render "authenticated_menu" if authenticated? %>

    <%= turbo_stream_from :flashes %>
    <%= turbo_stream_from [:flashes, I18n.locale] %>

    <%= render 'debugbar' if defined?(Debugbar) %>
  </body>
</html>
