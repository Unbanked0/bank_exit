<div class="hero bg-fixed bg-banner-projects">
  <div class="hero-overlay"></div>

  <div class="hero-content py-20">
    <div class="max-w-5xl space-y-8">
      <header class="text-center space-y-5">
        <h2 class="text-3xl font-bold"><%= t('.title') %></h2>
        <p class="text-lg"><%= t('.headline') %></p>
      </header>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <% projects.each do |project| %>
          <%= link_to project.link, class: 'card bg-base-100 hover:bg-base-200', target: (:_blank if project.external?) do %>
            <%= image_tag "projects/#{project.image}",
                class: 'object-cover w-full h-60 rounded-t-lg',
                alt: "Logo for #{project.title}",
                loading: :lazy %>

            <div class="p-3">
              <% if project.external? %>
                <div class="flex items-center gap-1 mb-2">
                  <h3 class="font-bold text-lg"><%= project.title %></h3>
                  <%= lucide_icon 'square-arrow-out-up-right', class: 'w-4' %>
                </div>
              <% else %>
                <h3 class="font-bold text-lg mb-2"><%= project.title %></h3>
              <% end %>

              <hr class="pb-2">

              <p class="mb-3"><%= project.description %></p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
