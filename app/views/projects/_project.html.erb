<%= link_to project.link, class: "card bg-base-200 hover:bg-primary hover:text-neutral! hover:-translate-y-2 shadow-sm motion-safe:transition-all!", target: (:_blank if project.external?) do %>
  <%= image_tag "projects/#{project.image}",
      class: 'bg-white object-cover w-full h-60 rounded-t-lg',
      alt: "Logo for #{project.title}",
      loading: :lazy %>

  <div class="card-body">
    <div class="card-title">
      <h3><%= project.title %></h3>

      <% if project.external? %>
        <%= lucide_icon 'square-arrow-out-up-right', class: 'inline-flex ml-1 w-4' %>
      <% end %>
    </div>

    <p><%= project.description %></p>
  </div>
<% end %>
