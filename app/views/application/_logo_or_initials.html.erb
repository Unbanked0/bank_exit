<%# locals: (model:, mode: :medium) %>
<%#
  To use this partial, you must send `model` params and
  it must respond to `#logo` (active_storage attachment),
  `#name` and `#initials`.
%>

<% case mode
when :tiny
  size = 'w-5 h-5'
  font_size = 'text-xs'
when :small
  size = 'w-8 h-8'
  font_size = 'text-md'
when :medium
  size = 'w-12 h-12'
  font_size = 'text-2xl'
when :extra_large
  size = 'w-32 h-32'
  font_size = 'text-7xl'
else # :large (fallback value)
  size = 'w-16 h-16'
  font_size = 'text-3xl'
end %>

<% if model.logo.attached? %>
  <div class="avatar">
    <div class="<%= class_names(["rounded-full bg-white", size]) %>">
      <%= image_tag url_for(model.logo), alt: "Logo for #{model.name}" %>
    </div>
  </div>
<% else %>
  <div class="avatar avatar-placeholder">
    <div
      class="<%= class_names(["rounded-full text-white", size]) %>"
      style="background-color: <%= model.name.to_rgb %>"
    >
      <span class="<%= font_size %>"><%= model.initials %></span>
    </div>
  </div>
<% end %>
