<%= turbo_stream.update :map_results do %>
  <%= render 'maps/merchants', merchants: @merchants, pagy: @pagy, query: @query %>
<% end %>

<% unless from_pagination? %>
  <%= turbo_stream.replace :map do %>
    <%= render 'maps/map', latitude: @latitude,
                           longitude: @longitude,
                           zoom: @zoom,
                           map_class: "rounded-box" %>
  <% end %>
  <%= turbo_stream.update :merchants_count do %>
    <%= render 'maps/merchants_count', pagy: @pagy %>
  <% end %>
  <%= turbo_stream.replace :display_modes do %>
    <%= render 'display_modes' %>
  <% end %>
<% end %>
