<%# locals: (merchant:, merchant_report:) %>

<% i18n_scope = "merchants.reports.modal" %>

<% content_for(:modal_title) do %>
  <%= merchant.name %>
<% end %>

<%= render_modal auto_open: true do %>
  <div class="alert alert-info alert-soft">
    <p class="text-sm">
      <%= t("introduction_html", scope: i18n_scope) %>
    </p>
  </div>

  <%= simple_form_for merchant_report,
        url: merchant_report_path(merchant),
        html: { class: "space-y-2 px-1" },
        method: :post do |f| %>
    <%= f.input :description, as: :text, label: false %>

    <%= f.input :nickname, wrapper_html: { class: "hidden" } %>

    <div class="flex justify-end">
      <%= f.button :submit,
            t("submit", scope: i18n_scope),
            class: "btn btn-success" %>
    </div>
  <% end %>
<% end %>
