<%# locals: (no_results:, detailed_steps:, route:, routing:, start_address:) %>

<% if no_results %>
  <div class="alert alert-warning">
    <p>
      <%= t('.no_results') %>
    </p>
  </div>
<% elsif detailed_steps && route.present? && route['legs'] %>
  <div class="alert alert-success alert-vertical gap-1">
    <% unless start_address.blank? %>
      <p>
        <strong><%= t('.start') %></strong>: <%= start_address %>
      </p>
    <% end %>

    <p>
      <strong><%= t('.distance') %></strong>:
      <%= number_to_human(route['distance'], units: :distance) %>
    </p>

    <p>
      <strong><%= t('.duration') %></strong>:
      <%= distance_of_time_in_words(route['duration']) %>
    </p>
  </div>
  <div class="font-semibold text-primary">
    <%= t('.routing_details') %>
  </div>
  <table class="table table-zebra">
    <tbody>
      <% route['legs'].each do |leg| %>
        <% leg['steps'].each_with_index do |step, index| %>
          <tr
            class="cursor-pointer hover:bg-base-300"
            data-controller="routings"
            data-routings-step-index-value="step_<%= index %>"
            data-action="click->routings#zoomRoad"
          >
            <td>
              <%= OSRMTextInstructions.compile(step) %>
            </td>

            <td>
              <% if step['distance'].positive? %>
                <p class="italic text-xs">
                  <%= number_to_human(step['distance'], units: :distance) %>
                </p>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if params[:debug] == 'true' %>
  <div class="mt-6">
    <h3 class="mb-2 uppercase font-bold text-primary">
      Routing
    </h3>

    <pre class="text-xs overflow-x-auto"><%= json_highlight(routing.to_h) %></pre>
  </div>
<% end %>
