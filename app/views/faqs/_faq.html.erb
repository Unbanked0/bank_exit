<details class="collapse collapse-arrow bg-base-100">
  <summary
    class="
      collapse-title font-semibold flex flex-col-reverse lg:flex-row justify-between
      gap-2
    "
  >
    <%= faq.question %>

    <div>
      <% faq.categories.each do |category| %>
        <span class="badge badge-sm badge-success">
          <%= t(".#{category}") %>
        </span>
      <% end %>
    </div>
  </summary>

  <div class="collapse-content">
    <% faq.content.each do |paragraph| %>
      <% if paragraph['answer']&.is_a?(String) %>
        <p><%== parsed_faq_answer(paragraph['answer']) %></p>
      <% elsif paragraph['answer']&.is_a?(Array) %>
        <div class="space-y-2">
          <ul class="list-disc list-inside">
            <% paragraph['answer'].each do |item| %>
              <li><%== parsed_faq_answer(item) %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>
</details>
